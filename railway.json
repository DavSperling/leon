{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm build"
  },
  "deploy": {
    "preDeployCommand": ["pnpm db:migrate"],
    "startCommand": "pnpm start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "overlapSeconds": "0",
    "drainingSeconds": "10",
    "restartPolicyType": "ON_FAILURE"
  }
}
