# Postgres local (docker compose). Mots de passe de développement : Postgres n'écoute que sur 127.0.0.1.
DATABASE_URL=postgres://leon_app:leon_app@127.0.0.1:54329/leon
DATABASE_URL_ADMIN=postgres://leon_owner:leon_owner@127.0.0.1:54329/leon
# Better Auth : 32 caractères au moins (openssl rand -base64 32). URL publique de l'app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# E-mails de réinitialisation du mot de passe (Resend). Obligatoires pour activer l'envoi en production.
RESEND_API_KEY=
LEON_EMAIL_FROM=
# « Continuer avec Google » (console Google Cloud, client OAuth « Application Web ») et « avec Microsoft » (Entra,
# inscription d'application multilocataire). Adresse de retour : <BETTER_AUTH_URL>/api/auth/callback/google (ou
# /microsoft). Vide : pas de bouton. Le SSO d'entreprise (Okta, SAML) se règle dans l'appli, pas ici.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Modèle d'IA : clé Anthropic, jamais commitée. Sans elle, Leon garde et indexe tout, mais ne répond pas.
ANTHROPIC_API_KEY=
# Modèle de chaque étape : la réponse en tête, la discussion, le point du matin, le résumé des sessions de code,
# l'état des fils de travail, les rendez-vous de la semaine, la fiche d'une personne (son rôle et ses tâches), les
# brouillons de réponse à ses mails, le tri qui les précède (ce mail attend-il une réponse ?). Vide : le modèle par
# défaut, le mieux noté des modèles Claude au banc de novembre 2026 (src/server/llm/models.ts) : Sonnet 5.5, sauf
# Opus 5.5 pour la discussion et Haiku 5.5 pour les rendez-vous. La fiche, les brouillons et le tri n'ont pas été
# mesurés au banc : Sonnet 5.5 pour les deux premiers, Haiku 5.5 pour le tri, qui ne rend qu'un oui ou un non.
# Une étape réglée ici sur un modèle d'OpenRouter est refaite chez Claude quand OpenRouter échoue.
# Modèles pris en charge : claude-haiku-5-5, claude-sonnet-5-5 et claude-opus-5-5, et par OpenRouter (avec
# OPENROUTER_API_KEY, plus bas) z-ai/glm-5.3-flash, deepseek/deepseek-v4.1-flash, deepseek/deepseek-v4.1-flash-1017,
# xiaomi/mimo-v2.6-flash, minimax/minimax-m3.1-flash, openai/gpt-6-luna, openai/gpt-6.1-terra et openai/gpt-6.2-sol ;
# tout autre nom empêche le démarrage.
LEON_MODEL_REPONSE=
LEON_MODEL_DISCUSSION=
LEON_MODEL_POINT=
LEON_MODEL_RESUME=
LEON_MODEL_FIL=
LEON_MODEL_AGENDA=
LEON_MODEL_FICHE=
LEON_MODEL_BROUILLON=
LEON_MODEL_TRI=
# Faux modèle pour les essais et les démos sans clé : mettre « factice ». Il répond toujours la même phrase,
# sans réseau. Refusé en production (l'app ne démarre pas). Laisser en commentaire : aucune valeur par défaut.
# LEON_LLM=
# Vecteurs de la recherche : le fournisseur est à choisir par Amos et David, après la comparaison sur le jeu d'essai.
# Valeurs possibles : factice (essais en local), voyage, mistral, bge-m3 ou openrouter. Vide : recherche par le texte seul.
# Voyage, Mistral et bge-m3 ne sont pas encore branchés : seul « factice » marche aujourd'hui.
LEON_EMBEDDINGS=
# Réglage du fournisseur choisi : la clé de Voyage ou de Mistral, ou l'adresse du service bge-m3.
VOYAGE_API_KEY=
MISTRAL_API_KEY=
LEON_BGE_URL=
# OpenRouter (LEON_EMBEDDINGS=openrouter) : une clé et le modèle de vecteurs, de 1 024 valeurs
# (voyageai/voyage-4, mistralai/mistral-embed-2312, baai/bge-m3…).
# La clé ouvre aussi les modèles d'OpenRouter aux étapes du modèle d'IA (LEON_MODEL_*, et les étapes dont le modèle
# préféré passe par OpenRouter) : les appels ne vont qu'à des hôtes sans rétention des données (zero data retention)
# et jamais à un hôte chinois.
# Elle s'ajoute à ANTHROPIC_API_KEY, qui reste obligatoire pour répondre. Vide : Claude pour toutes les étapes.
OPENROUTER_API_KEY=
LEON_EMBEDDINGS_MODEL=
# Limite de débit de la connexion : l'en-tête où le proxy de confiance pose l'adresse du client. Derrière Caddy :
# x-real-ip, avec « header_up X-Real-IP {remote_host} » dans son reverse_proxy (Caddy écrase la valeur du client),
# et le port de l'appli jamais publié. Obligatoire en production (`next start` refuse de démarrer sans) ; vide en
# développement : aucune adresse n'est lue, toutes les tentatives comptent ensemble.
LEON_IP_HEADER=
# Connecteurs : clé qui chiffre les clés d'API collées (32 octets en base64 : openssl rand -base64 32).
# Sans elle, la page Connexions ne permet pas de brancher un outil.
LEON_CONNECTORS_KEY=
# Boutons « Se connecter avec… » : une appli OAuth par éditeur, créée une fois (identifiant et secret).
# Une paire vide ou incomplète désactive le bouton de l'outil. Voir docs/guides/applis-oauth.md.
# ATLASSIAN sert à Jira et à Confluence.
LEON_OAUTH_GITHUB_ID=
LEON_OAUTH_GITHUB_SECRET=
# Le nom court de l'appli GitHub (github.com/apps/<nom>) : sans dépôt ouvert, le bouton enchaîne sur
# son écran d'installation, où l'on choisit les dépôts. Vide : l'utilisateur l'installe lui-même.
LEON_OAUTH_GITHUB_APP=
LEON_OAUTH_NOTION_ID=
LEON_OAUTH_NOTION_SECRET=
LEON_OAUTH_LINEAR_ID=
LEON_OAUTH_LINEAR_SECRET=
LEON_OAUTH_GITLAB_ID=
LEON_OAUTH_GITLAB_SECRET=
LEON_OAUTH_ATLASSIAN_ID=
LEON_OAUTH_ATLASSIAN_SECRET=
LEON_OAUTH_ASANA_ID=
LEON_OAUTH_ASANA_SECRET=
LEON_OAUTH_CLICKUP_ID=
LEON_OAUTH_CLICKUP_SECRET=
LEON_OAUTH_MONDAY_ID=
LEON_OAUTH_MONDAY_SECRET=
LEON_OAUTH_AIRTABLE_ID=
LEON_OAUTH_AIRTABLE_SECRET=
LEON_OAUTH_HUBSPOT_ID=
LEON_OAUTH_HUBSPOT_SECRET=
LEON_OAUTH_HELPSCOUT_ID=
LEON_OAUTH_HELPSCOUT_SECRET=
LEON_OAUTH_ATTIO_ID=
LEON_OAUTH_ATTIO_SECRET=
LEON_OAUTH_BASECAMP_ID=
LEON_OAUTH_BASECAMP_SECRET=
LEON_OAUTH_MIRO_ID=
LEON_OAUTH_MIRO_SECRET=
LEON_OAUTH_PRODUCTBOARD_ID=
LEON_OAUTH_PRODUCTBOARD_SECRET=
# MICROSOFT sert à Outlook, OneDrive / SharePoint, Teams et Teams Chat : une autre appli que MICROSOFT_CLIENT_*
# (la connexion à Leon). Son identifiant est aussi publié dans /.well-known/microsoft-identity-association.json.
LEON_OAUTH_MICROSOFT_ID=
LEON_OAUTH_MICROSOFT_SECRET=
# GOOGLE sert à Gmail et à Google Drive (appli non vérifiée : 100 utilisateurs au plus). Vide : ces deux boutons
# passent par Pipedream, ci-dessous.
LEON_OAUTH_GOOGLE_ID=
LEON_OAUTH_GOOGLE_SECRET=
# Slack passe par Pipedream Connect (appli OAuth et proxy de Pipedream, payé à la requête), et Gmail et Google
# Drive quand LEON_OAUTH_GOOGLE_* est vide. Le projet et un client OAuth de l'API Pipedream (pipedream.com >
# Settings > API), jamais commités. Vide : ces boutons sont désactivés. PIPEDREAM_ENVIRONMENT : development
# (gratuit, 10 comptes de test, il faut être connecté à pipedream.com) ou production (offre payante). Voir
# docs/etudes/pipedream-2026-10.
PIPEDREAM_PROJECT_ID=
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_ENVIRONMENT=development
# Commande pnpm leon : `pnpm leon login` enregistre la connexion dans ~/.leon/connexion.json. Si LEON_URL et LEON_TOKEN
# sont posées toutes les deux, elles passent avant cette connexion (les essais en local, le jeton se crée dans Réglages).
LEON_URL=http://localhost:3000
LEON_TOKEN=
# Sentry (projet « leon » de l'organisation cheron-inc, région US). SENTRY_DSN : où partent les erreurs du serveur ;
# vide, rien ne part. Le DSN se lit dans Sentry > Settings > Projects > leon > Client Keys. Pour des piles lisibles
# en production, Railway pose aussi SENTRY_AUTH_TOKEN au build (jeton d'organisation qui envoie les cartes de
# sources) : jamais ici, jamais commité.
SENTRY_DSN=
# Optionnelles
# Posées par Railway, à ne pas régler à la main : l'environnement et le commit que Sentry attache à chaque erreur.
# RAILWAY_ENVIRONMENT_NAME=
# RAILWAY_GIT_COMMIT_SHA=
# CLAUDE_CONFIG_DIR=
# Posée par Claude Code dans l'environnement de ses crochets (le dossier où la session a démarré) : à ne pas régler
# à la main. `leon capter-session` s'en sert quand le fichier de session n'écrit aucun dossier.
# CLAUDE_PROJECT_DIR=
# Base des tests sur base (défaut leon_test) : une branche qui supprime des tables prend la sienne.
# LEON_TEST_DATABASE=leon_test
# WXT_PUBLIC_LEON_URL=http://localhost:3000
# Les e-mails qui ouvrent le tableau de bord /admin, séparés par des virgules (vide : personne). Aucun e-mail n'est vérifié à
# l'inscription : n'y mettre que des adresses qui ont déjà un compte, sinon quiconque s'inscrit avec l'une d'elles
# devient admin.
LEON_ADMINS=
# Les alertes de Notion (webhooks, /api/notion/webhooks) : le jeton de vérification de l'abonnement, qui signe chaque
# alerte. Vide : Leon refuse les alertes et journalise le jeton qu'envoie Notion à la création de l'abonnement, à
# poser ici (puis redéployer) avant de cliquer Verify dans Notion. Voir docs/guides/applis-oauth.md (Notion).
LEON_NOTION_WEBHOOK_TOKEN=
