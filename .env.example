# Postgres local (docker compose). Mots de passe de développement : Postgres n'écoute que sur 127.0.0.1.
DATABASE_URL=postgres://leon_app:leon_app@127.0.0.1:54329/leon
DATABASE_URL_ADMIN=postgres://leon_owner:leon_owner@127.0.0.1:54329/leon
# Better Auth : 32 caractères au moins (openssl rand -base64 32). URL publique de l'app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Modèle d'IA : clé Anthropic, jamais commitée. Sans elle, Leon garde et indexe tout, mais ne répond pas.
ANTHROPIC_API_KEY=
# Connecteurs : clé qui chiffre les clés d'API collées (32 octets en base64 : openssl rand -base64 32).
# Sans elle, la page Connexions ne permet pas de brancher un outil.
LEON_CONNECTORS_KEY=
# Boutons « Se connecter avec… » : une appli OAuth par éditeur, créée une fois (identifiant et secret).
# Une paire vide ou incomplète désactive le bouton de l'outil. Voir docs/guides/applis-oauth.md.
# ATLASSIAN sert à Jira et à Confluence.
LEON_OAUTH_GITHUB_ID=
LEON_OAUTH_GITHUB_SECRET=
LEON_OAUTH_NOTION_ID=
LEON_OAUTH_NOTION_SECRET=
LEON_OAUTH_LINEAR_ID=
LEON_OAUTH_LINEAR_SECRET=
LEON_OAUTH_GITLAB_ID=
LEON_OAUTH_GITLAB_SECRET=
LEON_OAUTH_ATLASSIAN_ID=
LEON_OAUTH_ATLASSIAN_SECRET=
LEON_OAUTH_ASANA_ID=
LEON_OAUTH_ASANA_SECRET=
LEON_OAUTH_CLICKUP_ID=
LEON_OAUTH_CLICKUP_SECRET=
LEON_OAUTH_MONDAY_ID=
LEON_OAUTH_MONDAY_SECRET=
LEON_OAUTH_AIRTABLE_ID=
LEON_OAUTH_AIRTABLE_SECRET=
LEON_OAUTH_HUBSPOT_ID=
LEON_OAUTH_HUBSPOT_SECRET=
LEON_OAUTH_HELPSCOUT_ID=
LEON_OAUTH_HELPSCOUT_SECRET=
LEON_OAUTH_ATTIO_ID=
LEON_OAUTH_ATTIO_SECRET=
LEON_OAUTH_BASECAMP_ID=
LEON_OAUTH_BASECAMP_SECRET=
LEON_OAUTH_MIRO_ID=
LEON_OAUTH_MIRO_SECRET=
LEON_OAUTH_PRODUCTBOARD_ID=
LEON_OAUTH_PRODUCTBOARD_SECRET=
LEON_OAUTH_OUTLOOK_ID=
LEON_OAUTH_OUTLOOK_SECRET=
# Commande pnpm leon
LEON_URL=http://localhost:3000
LEON_TOKEN=
# Optionnelles
# CLAUDE_CONFIG_DIR=
# Base des tests sur base (défaut leon_test) : une branche qui supprime des tables prend la sienne.
# LEON_TEST_DATABASE=leon_test
# WXT_PUBLIC_LEON_URL=http://localhost:3000
